# ===================================
# Backend Environment Variables
# Copy this to .env and fill values
# ===================================

PORT=5000

# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com -> Connect -> Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/complaint_db?retryWrites=true&w=majority

# JWT Secret - use a long random string
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_abc123xyz

# Anthropic API Key
# Get from: https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

NODE_ENV=development
